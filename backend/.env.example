# CampaignCraft Configuration
# Copy this to .env and fill in your API keys

# ============================================
# AI Provider Selection
# ============================================
# Options: gemini (default), openai, claude, mock
AI_PROVIDER=gemini

# ============================================
# API Keys
# ============================================
# Google Gemini: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI GPT: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=

# Anthropic Claude: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=

# ============================================
# Optional: Database Configuration
# ============================================
# For future SQLite/PostgreSQL persistence
# DATABASE_URL=sqlite:///./campaign_craft.db

# ============================================
# Server Configuration (optional)
# ============================================
# HOST=0.0.0.0
# PORT=8000

# ============================================
# Logging Level (optional)
# ============================================
# DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO
